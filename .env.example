# Environment Variables Template
# AI-Driven Intelligent Greywater Management and Smart Reuse Routing System
# Copy this file to .env and configure local operational variables.

# Meteorological API Integration (Phase 9)
WEATHER_API_KEY=
WEATHER_LOCATION=New York, USA
WEATHER_LATITUDE=40.7128
WEATHER_LONGITUDE=-74.0060

# Streamlit Dashboard Configuration (Phase 13)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Simulation Settings (Phase 8 & 11)
SIMULATION_DEFAULT_SOURCE=Bathroom
SIMULATION_STEP_DELAY_SEC=1.0
